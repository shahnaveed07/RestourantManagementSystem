# Cloudflare Worker configuration reference
# Non-secret vars live in wrangler.jsonc ("vars").
# Local secrets live in .dev.vars (copy from .dev.vars.example).
# Production secrets are set with `npx wrangler secret put <NAME>`.

ENVIRONMENT="development"
DEMO_MODE="true"
DEMO_OTP="123456"
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
RESTAURANT_NAME="PassLine Restaurant"
TAX_RATE="0.08"
APP_ORIGIN="http://localhost:3000"

# Secret names (set in .dev.vars locally or via `wrangler secret put` in production)
JWT_SECRET=""
OTP_HASH_SECRET=""

# SMS Provider (twilio | msg91 — HTTP fetch only)
OTP_SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Email Provider (Resend REST API — HTTP fetch only)
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM="no-reply@passlinerestaurant.local"

# Optional Anti-Spam CAPTCHA (Cloudflare Turnstile or hCaptcha)
CAPTCHA_PROVIDER="turnstile"
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET=""
