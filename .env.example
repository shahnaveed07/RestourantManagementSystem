# Server Port (AI Studio requires port 3000)
PORT=3000

# MongoDB Connection URI (local MongoDB or Atlas).
# Leave empty to automatically use the built-in persistent local store (.data/passline-db.json).
MONGODB_URI=""

# JWT Signing Secrets (change in production)
JWT_SECRET="replace_with_strong_random_access_secret"
JWT_REFRESH_SECRET="replace_with_strong_random_refresh_secret"

# Enable Demo Mode (shows DEMO banner, 1-click demo logins, and Admin Demo Tools page)
DEMO_MODE="true"

# Restaurant Configuration
RESTAURANT_NAME="Linden & Rye"
TAX_RATE="0.08"

# CORS Allowed Origin (comma-separated origins, or leave empty for same-origin)
CORS_ORIGIN=""

# Public App URL (used for QR code target URLs)
APP_URL="http://localhost:3000"
