# Server Port (AI Studio requires port 3000)
PORT=3000
NODE_ENV="development"

# MongoDB Connection URI (local MongoDB or Atlas).
# Leave empty to automatically use the built-in persistent local store (.data/passline-db.json).
MONGODB_URI=""

# JWT Signing Secrets (change in production)
JWT_SECRET="replace_with_strong_random_access_secret"
JWT_REFRESH_SECRET="replace_with_strong_random_refresh_secret"

# Enable Demo Mode (MUST be false in production; server refuses to start if DEMO_MODE=true in production)
DEMO_MODE="true"
DEMO_OTP="123456"

# OTP Settings
OTP_EXPIRY_MINUTES="5"
OTP_MAX_ATTEMPTS="5"
OTP_SECRET="replace_with_strong_random_otp_hmac_secret"

# SMS Provider (twilio | msg91)
OTP_SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""

# Email SMTP via Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@passlinerestaurant.local"

# Optional Anti-Spam CAPTCHA (Turnstile or hCaptcha; enforced after 2 failed IP attempts when set)
CAPTCHA_PROVIDER="turnstile"
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET=""

# Restaurant Configuration
RESTAURANT_NAME="PassLine Restaurant"
TAX_RATE="0.08"

# CORS Allowed Origin (comma-separated origins, or leave empty for same-origin)
CORS_ORIGIN=""

# Public App URL (used for QR code target URLs)
APP_URL="http://localhost:3000"
